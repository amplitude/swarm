# ── Runtime Configuration ───────────────────────────────────────────────
#
# All config is optional. Defaults work out of the box for local usage.

# Inference provider: "ollama" (default) or "webllm"
# VITE_LLM_PROVIDER=ollama

# Ollama endpoint (only used when provider is "ollama")
# VITE_OLLAMA_ENDPOINT=http://localhost:11434

# Default model ID
# For Ollama: uses ollama/<model-name> format, e.g. ollama/qwen2.5-coder:0.5b
# For WebLLM: uses MLC model IDs from RECOMMENDED_MODELS in engine.ts
# VITE_LLM_MODEL=ollama/qwen2.5-coder:0.5b
