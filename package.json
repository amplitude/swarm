{
  "name": "swarm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "build:e2e": "vite build --config vite.e2e.config.ts",
    "preview:e2e": "node scripts/preview-e2e.mjs",
    "test:e2e": "playwright test",
    "audit:prod": "pnpm audit --prod",
    "audit:all": "pnpm audit",
    "bundle:assert": "node scripts/assert-bundle.mjs",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@mlc-ai/web-llm": "^0.2.78",
    "@monaco-editor/react": "^4.7.0",
    "dexie": "^4.0.11",
    "lucide-react": "^0.474.0",
    "mermaid": "^11.16.1",
    "nanoid": "^5.1.2",
    "quickjs-emscripten": "^0.32.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.3",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.0",
    "zustand": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "serialize-javascript": ">=7.0.3",
      "dompurify": ">=3.3.2",
      "mermaid@>=10.9.0-rc.1 <10.9.4": ">=10.9.4",
      "nanoid@<3.3.8": ">=3.3.8",
      "nanoid@>=4.0.0 <5.1.16": ">=5.1.16",
      "picomatch": ">=4.0.4",
      "lodash-es": ">=4.18.0",
      "immutable": ">=4.3.9"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.0.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^4.1.0"
  }
}
